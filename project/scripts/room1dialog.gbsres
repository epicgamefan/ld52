        "true": [
          {
            "command": "EVENT_TEXT",
            "args": {
              "text": [
                "While heading\nhome for the \nholidays,",
                "your car broke \ndown.",
                "You are in \nNowheresville, \nWest Virginia...",
                "Deep in the \nmountains on a\nstormy night.",
                "Your family will \nbe worried.  \n",
                "You want to let \nthem know that \nyou're not hurt.",
                "With no signal,\nyou are unable \nto call them.",
                "After walking \nmiles in the \nsleet and rain,",
                "you find yourself\nat an old desolate\nfacility.",
                "The storm is \ngrowing worse.\n",
                "No sense in \ntrying to\nhead back now.",
                "Better off \nfinding a way to \nget inside.",
                "Maybe you can \nwait the storm \nout overnight."
              ],
              "avatarId": "",
              "__collapse": false
            },
            "id": "98d5bcc6-bea2-4113-931a-d2dbb3ab879a"
