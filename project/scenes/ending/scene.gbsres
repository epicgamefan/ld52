    {
      "command": "EVENT_TEXT",
      "args": {
        "text": [
          "You won...",
          "The storm\ndissipates.",
          "You notice that\nyou have a signal\nagain.",
          "You look through\nyour text\nmessages.",
          "You have thirteen\nmissed text\nmessages.",
          "You begin to read\nthem aloud.",
          "Mom: Dear, where\nare you?",
          "Mom: Are you\nhaving car\ntrouble?",
          "Mom: We have your\nfavorite tonight:\nPot Roast",
          "Dad: Son, where\nare you?",
          "Dad: We've been\nwaiting all night.",
          "Dad: We are\nstarting to get\nreally worried.",
          "Dad: It's been\nanother hour and\nwe still haven't",
          "heard from you.",
          "Dad: We've called\nthe police and we\nasked them to get",
          "a search crew.",
          "Dad: If you ever\nget this message,",
          "please call us\nimmediately.",
          "Stephen: Hey Josh,\nare you there?",
          "Stephen: Your\nparents texted me.",
          "Stephen: They're\nworried sick about\nyou.",
          "Stephen: Call me\nwhen you see this.",
          "You put your cell\nphone down and you\nsmile.",
          "No one is ever\ngoing to believe\nthe story that you",
          "have to tell..."
        ],
        "avatarId": ""
      },
      "id": "f29f15d4-139e-48bc-934f-fd353c497f63"
    },
